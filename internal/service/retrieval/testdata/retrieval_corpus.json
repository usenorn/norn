    {"key": "testing-stdlib", "kind": "constraint", "statement": "Backend tests use the standard library testing package, no testify"},
    {"key": "oncall-escalate", "kind": "decision", "statement": "Page the secondary after fifteen minutes without acknowledgement"},
    {"key": "proposed-friday", "kind": "decision", "statement": "Move production deploys to Fridays", "status": "proposed"},
    {"key": "personal-rae", "kind": "preference", "statement": "I review pull requests before lunch", "visibility": "personal", "author": "rae"},
