    {"key": "future-rotation", "kind": "decision", "statement": "Adopt the new pager rotation", "effectiveFromDays": 1},
    {"key": "withdrawn-cache", "kind": "decision", "statement": "Cache API responses for an hour", "status": "withdrawn"},
