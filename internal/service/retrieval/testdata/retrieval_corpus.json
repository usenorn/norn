  "memories": [
    {"key": "deploy-day", "kind": "decision", "statement": "Production deploys go out on Tuesdays", "rationale": "QA is fully staffed then"},
    {"key": "deploy-freeze", "kind": "constraint", "statement": "No releases during the last week of the quarter", "rationale": "Finance closes the books"},
