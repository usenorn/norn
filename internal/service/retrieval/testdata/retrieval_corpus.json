    {"key": "db-choice", "kind": "decision", "statement": "Use Postgres for every service that stores state", "rationale": "One engine to operate and back up"},
    {"key": "cache-valkey", "kind": "decision", "statement": "Caching goes through Valkey, never in process memory"},
