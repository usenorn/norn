VALKEY_PORT=6381

GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
GARAGE_DEFAULT_BUCKET=norn-local
GARAGE_DEFAULT_ACCESS_KEY=GKe2a8bf08d27aa0e02c0e82f1
GARAGE_DEFAULT_SECRET_KEY=ee84b5e394e4bfe86282dfc0cfd7f523ae1044e48a836a922288a1b784398ba2
GARAGE_RPC_SECRET=968fb078df24d511d38c9ffb8f80e69b61c019a2b73e54e97524dc745bae94c3
GARAGE_ADMIN_TOKEN=yiVDwMSiIov7XxoTzStLIpudmGR9tCopq18YwXfzdm0=
GARAGE_METRICS_TOKEN=yAUsyon89+Rgo/pvTDwamqcd2njZ/rWRrYOZMoBRRfM=

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

NORN_APP_ENV=development
NORN_APP_LOG_LEVEL=debug
NORN_APP_BASE_URL=http://localhost:5174
NORN_HTTP_CLIENT_IP_HEADER=X-Forwarded-For
NORN_HTTP_TRUSTED_PROXIES=127.0.0.1,::1
NORN_POSTGRES_DSN=postgres://norn:norn@127.0.0.1:5433/norn?sslmode=disable
NORN_VALKEY_ADDR=127.0.0.1:6381
NORN_ASYNQ_ADDR=127.0.0.1:6381
NORN_SMTP_HOST=127.0.0.1
NORN_SMTP_PORT=1025
NORN_SMTP_FROM_ADDRESS=no-reply@norn.local
NORN_PASSWORD_BREACH_CHECK_ENABLED=false
NORN_STORAGE_BACKEND=s3
NORN_STORAGE_ROOT=./data/blobs
NORN_STORAGE_ENDPOINT=http://127.0.0.1:3900
NORN_STORAGE_BUCKET=norn-local
NORN_STORAGE_ACCESS_KEY_ID=GKe2a8bf08d27aa0e02c0e82f1
NORN_STORAGE_SECRET_ACCESS_KEY=ee84b5e394e4bfe86282dfc0cfd7f523ae1044e48a836a922288a1b784398ba2
NORN_GEOIP_DATABASE_PATH=
NORN_SECURITY_ENCRYPTION_KEY=
NORN_SAML_CERTIFICATE_SWEEP_SCHEDULE=0 8 * * *
NORN_CYCLES_GENERATION_SCHEDULE=5 0 * * *
NORN_LICENCE_KEY=
NORN_LICENCE_GRACE=720h

NORN_WEBHOOKS_FAN_OUT_SCHEDULE=* * * * *
NORN_WEBHOOKS_FAN_OUT_BATCH=200
NORN_WEBHOOKS_REQUEST_TIMEOUT=10s
NORN_WEBHOOKS_DIAL_TIMEOUT=5s
NORN_WEBHOOKS_MAX_RESPONSE_SIZE=65536
NORN_WEBHOOKS_SECRET_GRACE=24h
NORN_WEBHOOKS_RETENTION=720h
NORN_WEBHOOKS_SWEEP_SCHEDULE=0 5 * * *
NORN_WEBHOOKS_SWEEP_BATCH=5000
# Each entry punches a hole in the guard that refuses internal addresses. Leave
# empty unless a receiver genuinely sits on a private network.
NORN_WEBHOOKS_ALLOWED_DESTINATIONS=

# How much an import does at a time. None of these caps how much it may carry:
# an import is handed a backlog of unknown size and never counts it.
NORN_IMPORTS_CHUNK_SIZE=25
NORN_IMPORTS_PAGE_SIZE=200
# A slice must finish inside its lease, or a rescue starts a second worker on it.
NORN_IMPORTS_SLICE_BUDGET=45s
NORN_IMPORTS_LEASE_TTL=2m
NORN_IMPORTS_RESCUE_SCHEDULE=* * * * *
NORN_IMPORTS_RESCUE_BATCH=50
NORN_IMPORTS_MAX_ATTEMPTS=20
NORN_IMPORTS_MIN_BACKOFF=1s
NORN_IMPORTS_MAX_BACKOFF=15m
# The staged copy of a source's rows is working state. The ledger and the report
# that record what an import did are kept.
NORN_IMPORTS_RECORD_RETENTION=720h
# Each caps a single object, not how much an import may carry.
NORN_IMPORTS_MAX_ATTACHMENT_BYTES=26214400
# Bounded by NORN_HTTP_MAX_REQUEST_BYTES, which caps every dashboard route. Carrying a
# larger file means raising both; the server refuses to start if this one promises more.
NORN_IMPORTS_MAX_UPLOAD_BYTES=4194304

# Where an import reads a Linear workspace from. Settable so an instance can be pointed
# at a test double, and so a self-hoster behind an egress proxy can name one.
NORN_LINEAR_ENDPOINT=https://api.linear.app/graphql
NORN_LINEAR_REQUEST_TIMEOUT=30s
# A page of issues carrying descriptions is megabytes. Exceeding this is a named error
# rather than a truncated body, so it reads as a size problem instead of broken JSON.
NORN_LINEAR_MAX_RESPONSE_SIZE=33554432
NORN_LINEAR_PAGE_SIZE=100
