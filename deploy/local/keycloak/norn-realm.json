{
  "realm": "norn",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "norn-dashboard",
      "name": "Norn",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "norn-local-client-secret",
      "redirectUris": [
        "http://localhost:5173/v1/sso/oidc/callback",
        "http://localhost:8080/v1/sso/oidc/callback"
      ],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "groups": [{ "name": "engineering" }],
  "users": [
    {
      "username": "ada",
      "email": "ada@norn.local",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Lovelace",
      "enabled": true,
      "groups": ["/engineering"],
      "credentials": [{ "type": "password", "value": "ada-local-password", "temporary": false }]
    },
    {
      "username": "grace",
      "email": "grace@norn.local",
      "emailVerified": true,
      "firstName": "Grace",
      "lastName": "Hopper",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "grace-local-password", "temporary": false }]
    },
    {
      "username": "mallory",
      "email": "mallory@norn.local",
      "emailVerified": false,
      "firstName": "Mallory",
      "lastName": "Unverified",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "mallory-local-password", "temporary": false }
      ]
    }
  ]
}
