# The release to run. `latest` is the newest published release, which means a pull
# is an upgrade. Pin it to a version such as v1.0.0 to decide upgrades yourself:
# https://github.com/usenorn/norn/releases
NORN_VERSION=latest

# The public origin of this instance. Caddy takes its site address, its certificate
# and its scheme from this value, and the API refuses every write whose Origin header
# does not match it exactly.
NORN_APP_BASE_URL=https://norn.example.com

# Where Let's Encrypt sends certificate expiry notices.
ACME_EMAIL=admin@example.com

# The private network the containers share. Norn trusts forwarded client addresses
# from this range and no other, so every real client address is attributed correctly.
# Change it if it overlaps a network this host already uses.
NETWORK_SUBNET=172.30.0.0/16

# openssl rand -hex 32
# Both travel inside a connection string, so keep them to URL-safe characters or
# percent-encode them.
POSTGRES_PASSWORD=
VALKEY_PASSWORD=

# openssl rand -base64 32
# Protects every credential Norn stores encrypted: identity provider secrets, import
# credentials, source-control tokens, webhook signing keys. Keep a copy outside this
# host. Replacing it makes existing encrypted data unreadable.
NORN_SECURITY_ENCRYPTION_KEY=

# Required while NORN_APP_BASE_URL is https. Set it to false only for a plain-http
# instance on a trusted network.
NORN_SESSION_SECURE=true

NORN_APP_LOG_LEVEL=info

# Close signups once the first administrator account exists.
NORN_INSTANCE_SIGNUPS_OPEN=true

# Invitations and password recovery need outbound mail. Host and from address are set
# together or not at all. Authentication types are none, plain, login and cram-md5;
# TLS policies are none, opportunistic and mandatory.
NORN_SMTP_HOST=
NORN_SMTP_PORT=587
NORN_SMTP_USERNAME=
NORN_SMTP_PASSWORD=
NORN_SMTP_AUTH_TYPE=plain
NORN_SMTP_TLS_POLICY=mandatory
NORN_SMTP_FROM_ADDRESS=
NORN_SMTP_FROM_NAME=Norn

NORN_LICENCE_KEY=

# Every other setting is documented at
# https://docs.norn.so/self-hosting/environment-variables and can be added here.
