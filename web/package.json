{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.18.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "svelte-kit sync && vitest run",
		"test:watch": "svelte-kit sync && vitest",
		"gen:api": "openapi-typescript ../api/http/v1/dashboard.yaml -o src/lib/api/dashboard.gen.ts",
		"gen:api:check": "openapi-typescript ../api/http/v1/dashboard.yaml | diff -u src/lib/api/dashboard.gen.ts -",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@fontsource-variable/mona-sans": "5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.27.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.19.2",
		"@types/turndown": "^5.0.6",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"formsnap": "^2.0.1",
		"jsdom": "^28.1.0",
		"layerchart": "^2.5.0",
		"lucide": "^1.33.0",
		"morphicons": "^1.7.0",
		"openapi-typescript": "^7.13.0",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^3.0.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^4.1.12",
		"zod": "^4.6.7"
	},
	"dependencies": {
		"@sentry/sveltekit": "^10.76.2",
		"@tiptap/core": "^3.31.3",
		"@tiptap/extension-details": "3.31.3",
		"@tiptap/extension-image": "^3.31.3",
		"@tiptap/extension-list": "3.31.3",
		"@tiptap/extension-mention": "3.31.3",
		"@tiptap/extension-table": "3.31.3",
		"@tiptap/extensions": "3.31.3",
		"@tiptap/markdown": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"@tiptap/suggestion": "^3.31.3",
		"diff": "9.0.0",
		"isomorphic-dompurify": "^3.23.0",
		"marked": "^18.0.7",
		"openapi-fetch": "^0.17.0",
		"set-cookie-parser": "^3.1.2",
