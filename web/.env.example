# Error reporting is off unless a destination is set. Leave these empty and the app
# runs with no telemetry and contacts nobody.
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Session replay records the page itself, which in a tracker means issue titles,
# descriptions and comments. It stays off until a rate above zero is set here.
PUBLIC_SENTRY_REPLAY_SAMPLE_RATE=0
PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=0

# Build-time only: uploads source maps so a report points at readable code. All three
# are required together, and the build skips the upload when any is missing.
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
